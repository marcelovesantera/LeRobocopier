<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LeRobocopier.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <Pen x:Key="NavigationIconPen" Brush="{StaticResource TextPrimaryBrush}" Thickness="1.8" LineCap="Round" LineJoin="Round"/>
    <Pen x:Key="NavigationMenuPen" Brush="{StaticResource TextPrimaryBrush}" Thickness="1.8" LineCap="Square"/>
    <StreamGeometry x:Key="NavigationIconFrame">M0,0 L24,0 L24,24 L0,24 Z</StreamGeometry>
    <DrawingImage x:Key="CopyNavigationImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Brush="#FCFDFF" Pen="{StaticResource NavigationIconPen}" Geometry="M5,18 Q3,18 3,16 L3,4 Q3,2 5,2 L11,2 Q13,2 13,4 L13,16 Q13,18 11,18 Z"/>
          <GeometryDrawing Brush="#FCFDFF" Pen="{StaticResource NavigationIconPen}" Geometry="M9,6 L15,6 Q15.8,6 16.4,6.6 L20.4,10.6 Q21,11.2 21,12 L21,20 Q21,22 19,22 L9,22 Q7,22 7,20 L7,8 Q7,6 9,6 Z"/>
          <GeometryDrawing Pen="{StaticResource NavigationIconPen}" Geometry="M15,6 L15,10 Q15,12 17,12 L21,12"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="MoveNavigationImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Brush="#FCFDFF" Pen="{StaticResource NavigationIconPen}" Geometry="M2.75,8 L2.75,5.25 Q2.75,3.5 4.5,3.5 L9,3.5 Q9.8,3.5 10.4,4.1 L12.2,5.9 L19.5,5.9 Q21.25,5.9 21.25,7.65 L21.25,19.25 Q21.25,21 19.5,21 L4.5,21 Q2.75,21 2.75,19.25 Z M2.75,8.5 L21.25,8.5"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="RestoreNavigationImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Pen="{StaticResource NavigationIconPen}" Geometry="M3.5,9 C4.7,5.1 8,2.8 12,2.8 C17.1,2.8 21.2,6.9 21.2,12 C21.2,17.1 17.1,21.2 12,21.2 C7.7,21.2 4.1,18.2 3.1,14.3 M3.5,3.8 L3.5,9 L8.7,9 M12,7 L12,12.3 L15.6,14.7"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="ProjectsNavigationImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Pen="{StaticResource NavigationMenuPen}" Geometry="M2.5,5.5 L21.5,5.5 M2.5,12 L21.5,12 M2.5,18.5 L21.5,18.5"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="SettingsNavigationImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Pen="{StaticResource NavigationIconPen}" Geometry="M9.69,3.93 C9.90,1.36 14.10,1.36 14.31,3.93 C14.55,5.75 16.10,6.65 17.84,5.96 C20.16,4.86 22.26,8.50 20.15,9.97 C18.69,11.08 18.68,12.88 20.15,14.03 C22.26,15.50 20.16,19.14 17.84,18.04 C16.14,17.33 14.58,18.23 14.32,20.07 C14.10,22.64 9.90,22.64 9.69,20.07 C9.45,18.25 7.90,17.35 6.16,18.04 C3.84,19.14 1.74,15.50 3.85,14.03 C5.31,12.92 5.32,11.12 3.85,9.97 C1.74,8.50 3.84,4.86 6.16,5.96 C7.86,6.67 9.42,5.77 9.68,3.93 Z M15.3,12 A3.3,3.3 0 1 1 8.7,12 A3.3,3.3 0 1 1 15.3,12"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <LinearGradientBrush x:Key="EmptyFolderBackBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#8098B8" Offset="0"/>
      <GradientStop Color="#9BAEC7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmptyDocumentBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#DCE4F0" Offset="0"/>
      <GradientStop Color="#CBD6E6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmptyFolderFrontBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#B8D1F0" Offset="0"/>
      <GradientStop Color="#9FBEE7" Offset="1"/>
    </LinearGradientBrush>
    <Pen x:Key="EmptyDocumentPen" Brush="#AABBD2" Thickness="4.5" LineCap="Round"/>
    <Pen x:Key="EmptyFolderHighlightPen" Brush="#D3E2F5" Thickness="1.2" LineCap="Round"/>
    <Pen x:Key="EmptyRaysPen" Brush="#8FA4C0" Thickness="4.5" LineCap="Round"/>
    <DrawingImage x:Key="EmptyProjectsImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#F0F4F9" Geometry="M220,110 A110,110 0 1 1 0,110 A110,110 0 1 1 220,110"/>
          <DrawingGroup>
            <DrawingGroup.Transform>
              <TranslateTransform X="4" Y="-5"/>
            </DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource EmptyFolderBackBrush}" Geometry="M22,101 Q21,92 30,92 L137,92 Q145,92 146,101 L148,188 L30,188 Z"/>
            <GeometryDrawing Brush="{StaticResource EmptyDocumentBrush}" Geometry="M76,59 Q76,50 85,51 L132,55 L152,79 L145,151 L68,145 Z"/>
            <GeometryDrawing Brush="#BCCADD" Geometry="M132,55 L152,79 L137,77 Q130,76 132,68 Z"/>
            <GeometryDrawing Pen="{StaticResource EmptyDocumentPen}" Geometry="M88,74 L115,77 M86,88 L131,93 M84,102 L129,107"/>
            <GeometryDrawing Brush="{StaticResource EmptyFolderFrontBrush}" Geometry="M49,123 Q51,115 59,115 L160,115 Q169,115 166,125 L151,185 Q149,192 142,192 L35,192 Q27,192 30,182 Z"/>
            <GeometryDrawing Pen="{StaticResource EmptyFolderHighlightPen}" Geometry="M53,119 Q55,116 61,116 L159,116 Q166,116 164,123"/>
          </DrawingGroup>
          <GeometryDrawing Pen="{StaticResource EmptyRaysPen}" Geometry="M178,89 L184,77 M188,103 L203,96 M190,119 L205,122"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="ModalPadding">24</Thickness>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="ModalRadius">16</CornerRadius>
    <StreamGeometry x:Key="FileIcon">M5,2 L15,2 L21,8 L21,22 L5,22 Z M7,4 L7,20 L19,20 L19,9 L14,9 L14,4 Z</StreamGeometry>
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F4F8FC"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F8FAFD"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE5F0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#53647E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0067E8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#005ACB"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#004DAF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#E8F2FF"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#A8CEFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#DCEAFF"/>
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#DFE9F5"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#157A30"/>
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E8F7ED"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5200"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF4D6"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F6C7CC"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFDADA"/>
    <SolidColorBrush x:Key="DangerHoverBorderBrush" Color="#EAA5AF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#660F172A"/>
    <Pen x:Key="SettingsIconPen" Brush="{StaticResource AccentBrush}" Thickness="1.8" LineCap="Round" LineJoin="Round"/>
    <DrawingImage x:Key="SettingsFolderImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Pen="{StaticResource SettingsIconPen}" Geometry="M3,8 L3,5.5 Q3,4 4.5,4 L9,4 L12,7 L19.5,7 Q21,7 21,8.5 L21,19 Q21,20.5 19.5,20.5 L4.5,20.5 Q3,20.5 3,19 Z M3,8 L21,8"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="InactiveProjectsImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Pen="{StaticResource SettingsIconPen}" Geometry="M12,7.5 A3.5,3.5 0 1 1 5,7.5 A3.5,3.5 0 1 1 12,7.5 Z M19.5,8.5 A3,3 0 1 1 13.5,8.5 A3,3 0 1 1 19.5,8.5 Z"/>
          <GeometryDrawing Pen="{StaticResource SettingsIconPen}" Geometry="M2.5,20 L2.5,18 C2.5,15.8 4.3,14 6.5,14 L10.5,14 C12.7,14 14.5,15.8 14.5,18 L14.5,20 Z M17.5,14.5 C20,14.5 21.5,16 21.5,18.5 L21.5,20 L18,20"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="BackNavigationImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Pen="{StaticResource NavigationIconPen}" Geometry="M20,12 L4,12 M10,6 L4,12 L10,18"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <Pen x:Key="FilesActionPen" Brush="White" Thickness="1.8" LineCap="Round" LineJoin="Round"/>
    <Pen x:Key="DangerIconPen" Brush="{StaticResource DangerBrush}" Thickness="1.8" LineCap="Round" LineJoin="Round"/>
    <DrawingImage x:Key="FilesActionImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Pen="{StaticResource FilesActionPen}" Geometry="M6,18 L5,18 Q3,18 3,16 L3,4 Q3,2 5,2 L11,2 Q13,2 13,4 L13,5 M9,6 L15,6 L21,12 L21,20 Q21,22 19,22 L9,22 Q7,22 7,20 L7,8 Q7,6 9,6 Z M15,6 L15,10 Q15,12 17,12 L21,12"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="TrashActionImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="{StaticResource NavigationIconFrame}"/>
          <GeometryDrawing Pen="{StaticResource DangerIconPen}" Geometry="M4,6 L20,6 M9,6 L9,3 L15,3 L15,6 M6,6 L7,21 L17,21 L18,6 M10,10 L10,17 M14,10 L14,17"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <StreamGeometry x:Key="ProjectIcon">M4,2 L16,2 L16,5 L14,5 L14,4 L6,4 L6,16 L7,16 L7,18 L4,18 Z M8,6 L20,6 L20,22 L8,22 Z M10,8 L10,20 L18,20 L18,8 Z</StreamGeometry>
    <StreamGeometry x:Key="FolderIcon">M2,5 L9,5 L12,8 L22,8 L22,21 L2,21 Z M4,7 L4,19 L20,19 L20,10 L11,10 L8,7 Z</StreamGeometry>
    <StreamGeometry x:Key="MoveIcon">M2,5 L9,5 L12,8 L22,8 L22,21 L2,21 Z M4,7 L4,19 L20,19 L20,10 L11,10 L8,7 Z M6,13 L14,13 L14,11 L18,14 L14,17 L14,15 L6,15 Z</StreamGeometry>
    <StreamGeometry x:Key="RestoreIcon">M3,3 L5,3 L5,6 C13,-2 24,5 23,14 C22,24 7,26 3,17 L5,16 C9,23 20,22 21,14 C22,6 12,1 7,7 L11,7 L11,9 L3,9 Z M11,7 L13,7 L13,12 L17,15 L16,17 L11,13 Z</StreamGeometry>
    <StreamGeometry x:Key="SettingsIcon">M3,4 L21,4 L21,6 L3,6 Z M3,11 L21,11 L21,13 L3,13 Z M3,18 L21,18 L21,20 L3,20 Z M7,2 L9,2 L9,8 L7,8 Z M15,9 L17,9 L17,15 L15,15 Z M7,16 L9,16 L9,22 L7,22 Z</StreamGeometry>
    <StreamGeometry x:Key="AddIcon">M11,3 L13,3 L13,11 L21,11 L21,13 L13,13 L13,21 L11,21 L11,13 L3,13 L3,11 L11,11 Z</StreamGeometry>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <Style Selector="Border.folder-section">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    </Style>
    <Style Selector="Border.folder-path">
      <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
    </Style>
    <Style Selector="Border.folder-error">
      <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://LeRobocopier.Desktop/Assets/lerobocopier-small-icon.png"/>
      <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.projects-title">
      <Setter Property="FontSize" Value="36"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.settings-title">
      <Setter Property="FontSize" Value="36"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.editor-title">
      <Setter Property="FontSize" Value="36"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.settings-card-title">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.empty-title">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.new-project">
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="20,12"/>
    </Style>
    <Style Selector="Button.editor-action">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style Selector="Button.breadcrumb">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="0,4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.rename-project">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.project-name">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="TextBlock.modal-title">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="PathIcon">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
      <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>
    <Style Selector="Border.settings-card">
      <Setter Property="Padding" Value="24"/>
      <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
    </Style>
    <Style Selector="Border.settings-icon-badge">
      <Setter Property="Width" Value="56"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="CornerRadius" Value="28"/>
      <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.inactive-project-row">
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
    </Style>
    <Style Selector="TextBox.backup-root">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style Selector="CheckBox.confirmation-option">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="Button:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.primary PathIcon">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.danger PathIcon">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
    </Style>
    <Style Selector="Button.danger:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerHoverBorderBrush}"/>
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="Button:focus-visible:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="4,0,0,0"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Padding" Value="9,13,13,13"/>
    </Style>
    <Style Selector="Button.nav:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource NavigationHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.nav:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="Button.nav:focus-visible:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="4,2,2,2"/>
      <Setter Property="Padding" Value="9,11,11,11"/>
    </Style>
    <Style Selector="Button.nav:disabled">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.navigation-tool">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.navigation-tool.selected">
      <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
      <Setter Property="BorderThickness" Value="4,1,1,1"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBox:disabled">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="CheckBox:disabled">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="CheckBox:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="ListBox.projects">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.operation-lines">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.operation-lines ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
    </Style>
    <Style Selector="Border.project-list-surface">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
    </Style>
    <Style Selector="Border.project-details">
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style Selector="Border.project-details TextBlock">
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Button.project-open">
      <Setter Property="MinWidth" Value="76"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="16,6"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem Border.project-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem:pointerover Border.project-card">
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem:selected Border.project-card">
      <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="4,1,1,1"/>
    </Style>
    <Style Selector="ListBox.projects ListBoxItem:focus-visible Border.project-card">
      <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
      <Setter Property="BorderThickness" Value="4,2,2,2"/>
    </Style>
    <Style Selector="Border.success">
      <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}"/>
    </Style>
    <Style Selector="Border.warning">
      <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}"/>
    </Style>
    <Style Selector="Border.error">
      <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
    </Style>
    <Style Selector="TextBlock.success">
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>
    <Style Selector="TextBlock.editor-empty-description">
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Grid.editor.compact Button.editor-action">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style Selector="Grid.editor.compact Button.breadcrumb">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="0,2"/>
    </Style>
    <Style Selector="Grid.editor.compact TextBlock.editor-title">
      <Setter Property="FontSize" Value="28"/>
    </Style>
    <Style Selector="Grid.editor.compact TextBox.project-name">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,4"/>
    </Style>
    <Style Selector="Grid.editor.compact TextBlock.editor-note">
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Grid.editor.compact Border.editor-empty">
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style Selector="Grid.editor.compact Grid.editor-empty-content">
      <Setter Property="RowSpacing" Value="6"/>
    </Style>
    <Style Selector="Grid.editor.compact TextBlock.editor-empty-title">
      <Setter Property="FontSize" Value="22"/>
    </Style>
    <Style Selector="Grid.editor.compact TextBlock.editor-empty-description">
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Application.Styles>
</Application>
